# Public Ethereum RPC used for read-only eth_call / eth_getCode lookups.
# Default is https://ethereum.publicnode.com (no key, verified working).
# Fallback built into the server: https://eth.llamarpc.com.
# NOTE: https://rpc.ankr.com/eth now requires an API key — do NOT use it here.
# No API key is used or needed by this agent.
RPC_URL=https://ethereum.publicnode.com

# Local port the server listens on. The tunnel forwards to this port.
PORT=3001
